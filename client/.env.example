# ==========================================
# LensCraft Client - Environment Variables
# ==========================================

# Base API URL:
# - Leave empty or '/api' when running fullstack monolith mode (Render / Docker single URL)
# - Set to 'https://your-backend.onrender.com/api' if deploying frontend independently (Vercel / Netlify)
VITE_API_BASE_URL=http://localhost:5000/api

# App Display Name
VITE_APP_NAME=LensCraft

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

