# ==========================================
# LensCraft Server - Production Environment Variables
# ==========================================

PORT=5000
NODE_ENV=production

# CORS allowed frontend origin(s). Supports comma-separated list or '*'
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (MongoDB Atlas in Production)
MONGODB_URI=mongodb://127.0.0.1:27017/lenscraft_db

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_lenscraft_2025_at_least_32_chars
JWT_EXPIRES_IN=7d

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Client ID (Create in Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI & Machine Learning Configuration (Optional: system automatically activates grounded fallbacks if omitted)
# 1. Google Gemini API Key (Technology 3: AI Conversational Concierge)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Hugging Face API Key (Technology 2: Zero-shot CLIP ViT-B/32 Image Classification)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# 3. Python AI Microservice URL (Technologies 4 & 5: Gradient Boosting Packages & Multilingual NLP)
AI_SERVICE_URL=http://localhost:8000


