# ==========================================
# LensCraft Platform - Environment Configuration
# ==========================================

# Server Port (Default: 5000)
PORT=5000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Client Application URL (For CORS whitelist)
# In production, set to your frontend domain (e.g. https://lenscraft.vercel.app)
# Supports comma-separated domains or '*' for wildcard
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# Atlas Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/lenscraft_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/lenscraft_db

# JWT Authentication Secret & Expiration
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage (Optional: fallback to mock images if omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Client ID (Used for Sign In with Google)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# AI & Machine Learning Configuration (Optional: system automatically activates grounded fallbacks if omitted)
# 1. Google Gemini API Key (Technology 3: AI Conversational Concierge)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Hugging Face API Key (Technology 2: Zero-shot CLIP ViT-B/32 Image Classification)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# 3. Python AI Microservice URL (Technologies 4 & 5: Gradient Boosting Packages & Multilingual NLP)
AI_SERVICE_URL=http://localhost:8000


