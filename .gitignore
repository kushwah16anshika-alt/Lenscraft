# ==========================================
# LensCraft Platform - .gitignore
# ==========================================

# 1. Dependencies
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged

# 2. Environment Variables & Secrets (CRITICAL)
.env
.env.*
*.env
*.env.*
client/.env
client/.env.*
server/.env
server/.env.*

# Explicitly keep example environment templates tracked
!.env.example
!client/.env.example
!server/.env.example
!**/.env.example

# 3. Certificates & Secret Keys
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# 4. Production Builds & Outputs
dist/
dist-ssr/
build/
client/dist/
server/dist/
out/
.next/

# 5. Testing & Code Coverage
coverage/
.nyc_output/
*.lcov

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. Caches & Temporary Files
screenshot*.png
.cache/
.vite/
client/.vite/
.eslintcache
.parcel-cache
.turbo
*.tmp
*.temp
*.bak
*~

# 8. Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 9. IDE & Editor Artifacts
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# 10. Python & ML Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
